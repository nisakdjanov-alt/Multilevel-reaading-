$("#list").innerHTML=TESTS.length?TESTS.map(t=>{const s=loadST(t.id),n=total(t),id=esc(t.id);
const pill=s.done?`<span class="pill ok">Score ${s.score}/75</span>`:s.st?`<span class="pill">In progress</span>`:`<span class="pill">New</span>`;
