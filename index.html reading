$("#list").onclick=e=>{const b=e.target.closest("[data-a]");if(!b)return;const id=b.dataset.id,a=b.dataset.a;
if(a=="open")openTest(id);else if(a=="edit")edit(id);else if(a=="del"){const t=TESTS.find(x=>x.id==id);ask(`Delete "${t.title}" and its saved progress?`,()=>{TESTS=TESTS.filter(x=>x.id!=id);ls.del(skey(id));saveTests();home()},"Delete")}};
$("#add").onclick=()=>edit(null);$("#hm").onclick=home;$("#bk").onclick=()=>{checked=false;result()};
$("#rest").onclick=()=>{let n=0;(window.DEFAULT_TESTS||[]).forEach(d=>{if(!TESTS.some(t=>t.id==d.id)){TESTS.push(JSON.parse(JSON.stringify(d)));n++}});saveTests();home();note(n?"Sample test restored.":"The sample test is already in your library.")};
let dip=null;addEventListener("beforeinstallprompt",e=>{e.preventDefault();dip=e;$("#inst").hidden=false});
