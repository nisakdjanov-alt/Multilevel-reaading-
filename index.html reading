<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Multilevel Reading</title>
<meta name="theme-color" content="#0A0F2C">
<meta name="color-scheme" content="dark">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Multilevel">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Source+Serif+4:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#0A0F2C;--card:#131B45;--card2:#1A2459;--ink:#EEF2FF;--mut:#98A4D0;--line:#273065;--ac:#2DD4BF;--ac2:#6366F1;--ok:#34D399;--oks:#0E3A2D;--bad:#FB7185;--bads:#4B1B2B;--y:#F6D775;--sans:"Bricolage Grotesque",system-ui,sans-serif;--serif:"Source Serif 4",Georgia,serif;
color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}*{box-sizing:border-box}[hidden]{display:none!important}
body{margin:0;min-height:100%;color:var(--ink);font:16px/1.5 var(--sans);background:radial-gradient(900px 520px at 90% -10%,#3B3FA855,transparent),radial-gradient(700px 420px at -10% 8%,#0FB5A033,transparent),var(--bg);background-attachment:fixed}
button{font:inherit;color:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--y);outline-offset:2px}
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;display:flex;align-items:center;gap:10px;padding:10px 14px;background:#0A0F2Ccc;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:10px;flex:1;min-width:0}.brand b{display:block;font-weight:800;line-height:1.1}.brand small{color:var(--mut);font-size:12px}
.lg{width:36px;height:36px;flex:none}
#tm{font:800 22px var(--sans);font-variant-numeric:tabular-nums;padding:4px 12px;border-radius:12px;background:var(--card);border:1px solid var(--line)}#tm.low{color:var(--bad);border-color:var(--bad)}
.b{background:linear-gradient(135deg,var(--ac2),var(--ac));color:#04122B;border:0;border-radius:13px;padding:10px 18px;font-weight:800}
.b.g{background:none;color:var(--ink);border:2px solid var(--line)}.b.sm{padding:7px 12px;font-size:14px}
main{max-width:1300px;margin:0 auto;padding:16px 14px 50px}
.card{background:linear-gradient(180deg,var(--card),#10173B);border:1px solid var(--line);border-radius:22px;padding:clamp(14px,3vw,24px);box-shadow:0 10px 40px #0005}
.narrow{max-width:520px;margin:20px auto}
.hint{font-size:13px;color:var(--mut);margin:0 0 12px}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.row.c{justify-content:center}
h2,h3{margin:0}
/* home */
.hero{text-align:center;padding:26px 8px 18px}.hero .lg{width:92px;height:92px;filter:drop-shadow(0 12px 30px #2DD4BF55)}
.hero h1{font-size:clamp(30px,7vw,46px);margin:12px 0 4px;font-weight:800;letter-spacing:-.02em;background:linear-gradient(90deg,#fff,var(--ac));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{color:var(--mut);margin:0 auto;max-width:460px}
.list{display:grid;gap:14px;max-width:760px;margin:12px auto}
.tc h3{font-size:20px}.tc p{margin:2px 0 0;color:var(--mut);font-size:14px}.tc-h{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;margin-bottom:14px}
.pill{font-size:12px;font-weight:800;padding:5px 11px;border-radius:99px;background:var(--card2);border:1px solid var(--line);white-space:nowrap}.pill.ok{background:var(--oks);color:var(--ok);border-color:#1b6b50}
.add{display:block;max-width:760px;margin:16px auto;width:100%;border:2px dashed var(--line);background:none;border-radius:20px;padding:18px;font-weight:800;color:var(--ac)}
.foot{max-width:760px;margin:10px auto;color:var(--mut);font-size:13px;text-align:center}.foot button{background:none;border:0;color:var(--ac);text-decoration:underline;font-size:13px}
/* tabs */
.tabs{display:flex;gap:8px;padding:2px 0 12px;overflow-x:auto}
.tab{flex:none;border:2px solid var(--line);background:var(--card);border-radius:14px;padding:8px 14px;font-weight:800}.tab small{display:block;font-weight:600;color:var(--mut);font-size:12px}
.tab[aria-pressed=true]{border-color:var(--ac);background:#0F3A44}
#fab{position:fixed;right:14px;bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:6;border-radius:99px;box-shadow:0 8px 24px #000a;padding:12px 18px}
.grid{display:grid;gap:14px}
@media(min-width:960px){.grid{grid-template-columns:1.15fr 1fr}.sc{max-height:calc(100vh - 170px);overflow:auto}#fab{display:none}}
.sc{align-self:start}
/* passage */
.pass{font:400 18px/1.8 var(--serif);color:#E4E9FF}.pass h2{font:800 22px var(--sans);margin:0 0 12px;color:#fff}.pass h3{font:800 17px var(--sans);margin:16px 0 4px}.pass p{margin:0 0 14px}
mark{color:#111;border-radius:4px;padding:1px 0;cursor:pointer}mark.y{background:var(--y)}mark.g{background:#8EE0AE}mark.p{background:#F6A9BE}mark.u{background:none;color:inherit;text-decoration:underline;text-decoration-thickness:3px;text-underline-offset:4px;text-decoration-color:var(--ac)}mark.has::after{content:"✎";font-size:.7em;margin-left:2px}
.gw{display:inline-flex;align-items:center;gap:3px;vertical-align:baseline;margin:0 2px;padding:0 6px 0 7px;border-radius:9px;background:#F6D77522;border:1px solid #F6D77566}
.gw em{font:800 11px var(--sans);color:#14100A;background:var(--y);border-radius:6px;padding:2px 5px;font-style:normal}
.gap{width:10ch;min-width:0;background:transparent;border:0;border-bottom:2px solid var(--y);border-radius:0;color:var(--y);font:800 17px var(--sans);text-align:center;padding:2px 4px;margin:0 0 -1px}
.gw:focus-within{box-shadow:0 0 0 3px #F6D77555}.gap:focus-visible{outline:0}
.gw.ok{background:#34D39922;border-color:#34D39988}.gw.ok .gap{color:var(--ok);border-color:var(--ok)}.gw.no{background:#FB718522;border-color:#FB718588}.gw.no .gap{color:var(--bad);border-color:var(--bad);text-decoration:line-through}
.ans{color:var(--ok);font:800 14px var(--sans);margin-left:4px}
/* tools */
.tl{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:10px}.tl b{font-size:13px;color:var(--mut)}
.c{width:32px;height:32px;border-radius:50%;border:2px solid #fff6;padding:0}.c.y{background:var(--y)}.c.g{background:#8EE0AE}.c.p{background:#F6A9BE}
.tl [aria-pressed=true]{outline:3px solid #fff;outline-offset:2px}
.t2{border:2px solid var(--line);background:none;border-radius:10px;padding:5px 10px;font-weight:800;font-size:14px}.t2[aria-pressed=true]{background:var(--ink);color:#0A0F2C}
.ph{margin:18px 0 6px;font-size:15px}#pad,#ej{width:100%;min-height:120px;border:2px solid var(--line);border-radius:14px;background:#0C1233;color:var(--ink);padding:12px;font:inherit;resize:vertical}
#ej{min-height:46vh;font:13px/1.45 ui-monospace,Menlo,Consolas,monospace}
/* questions */
.q{padding:14px 0;border-top:1px solid var(--line)}.q:first-of-type{border-top:0}.q p{margin:0 0 9px;font-weight:700}.q .n{display:inline-grid;place-items:center;min-width:26px;height:26px;border-radius:8px;background:var(--card2);color:var(--ac);font-weight:800;margin-right:8px;font-size:14px}
.opts{display:flex;flex-direction:column;gap:7px}.opts.r{flex-direction:row;flex-wrap:wrap}
.o{text-align:left;border:2px solid var(--line);background:none;border-radius:12px;padding:9px 13px;line-height:1.35}.o[aria-pressed=true]{border-color:var(--ac);background:#0F3A44}
input.gq,select{border:2px solid var(--line);background:#0C1233;color:var(--ink);border-radius:12px;padding:9px 12px;font:inherit;min-width:170px}
.q.ok{background:var(--oks);border-radius:14px;padding:14px;border-color:transparent}.q.no{background:var(--bads);border-radius:14px;padding:14px;border-color:transparent}.key{font-size:14px;margin-top:7px;font-weight:800}
.ref{background:#0C1233;border:1px solid var(--line);border-radius:14px;padding:11px 14px;font-size:14.5px;margin-bottom:10px}.tip{background:#F6D77518;border:1px solid #F6D77555;color:var(--y);border-radius:12px;padding:9px 12px;font-size:14px;margin-bottom:8px}
/* result */
.rs{max-width:560px;margin:18px auto;text-align:center}.ring{--p:0;width:200px;height:200px;border-radius:50%;margin:14px auto;background:conic-gradient(var(--ac) calc(var(--p)*1%),#243066 0);display:grid;place-items:center}
.ring>div{width:160px;height:160px;border-radius:50%;background:var(--card);display:flex;flex-direction:column;align-items:center;justify-content:center}.ring b{font-size:60px;line-height:1;font-weight:800}.ring span{color:var(--mut);font-weight:800}
.lead{font-size:18px;font-weight:700;margin:0 0 14px}.parts{display:grid;gap:8px;margin-bottom:18px}.parts div{display:flex;justify-content:space-between;background:#0C1233;border:1px solid var(--line);border-radius:12px;padding:9px 14px}
/* floating */
#tb,#pop{position:fixed;z-index:20;background:#EEF2FF;color:#0A0F2C;border-radius:14px;padding:8px;display:flex;gap:6px;box-shadow:0 8px 30px #000a;align-items:center}
#tb .t,#pop .t{background:none;border:0;font-weight:800;padding:0 8px;color:#0A0F2C}
#pop{flex-direction:column;align-items:stretch;width:min(290px,90vw)}#pop textarea{width:100%;min-height:70px;border-radius:10px;border:1px solid #c5cdf0;padding:8px;font:inherit;background:#fff;color:#0A0F2C}#pop .r{display:flex;gap:6px;align-items:center}
#dlg{position:fixed;inset:0;z-index:50;background:#000a;display:flex;align-items:center;justify-content:center;padding:20px}#dlg .card{max-width:420px;width:100%}
.msg{min-height:22px;font-weight:700;margin:10px 0}.msg.bad{color:var(--bad)}.msg.good{color:var(--ok)}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style></head>
