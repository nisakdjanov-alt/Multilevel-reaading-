<p><input type="text" id="fn" class="gq" placeholder="First name" autocomplete="given-name" style="width:100%"></p><p><input type="text" id="ln" class="gq" placeholder="Last name" autocomplete="family-name" style="width:100%"></p>
<button class="b" id="go" style="width:100%;padding:14px">Start test</button></section>
