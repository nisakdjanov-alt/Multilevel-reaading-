let lt=0,lx=0,ly=0;
ps.addEventListener("pointerup",e=>{if(tool=="e"||checked||e.target.closest("input"))return;const n=Date.now();if(n-lt<350&&Math.hypot(e.clientX-lx,e.clientY-ly)<30){lt=0;dbl(e)}else{lt=n;lx=e.clientX;ly=e.clientY}});
function dbl(e){if(e.target.closest("mark"))return;let r;if(document.caretRangeFromPoint)r=document.caretRangeFromPoint(e.clientX,e.clientY);else if(document.caretPositionFromPoint){const c=document.caretPositionFromPoint(e.clientX,e.clientY);if(c){r=document.createRange();r.setStart(c.offsetNode,c.offset)}}
if(!r||r.startContainer.nodeType!=3)return;const t=r.startContainer.textContent,w=/[\p{L}\p{N}'’-]/u;let a=r.startOffset,b=a;while(a>0&&w.test(t[a-1]))a--;while(b<t.length&&w.test(t[b]))b++;if(a==b)return;const g=document.createRange();g.setStart(r.startContainer,a);g.setEnd(r.startContainer,b);rg=g;wrap("y")}
/* ---------- editor ---------- */
const TEMPLATE=JSON.stringify({title:"My New Test",minutes:60,parts:[{name:"Part 1",instruction:"Fill each gap with ONE word.",passage:["# Text title","A paragraph with a gap (1)_______ inside it."],questions:[{n:1,type:"gap",text:"Gap 1",answer:"word"}]},{name:"Part 2",instruction:"Choose the correct answer.",passage:["# Another text","Some text to read."],questions:[{n:2,type:"mcq",text:"Question?",options:["First","Second","Third","Fourth"],answer:"B"},{n:3,type:"tf",text:"A statement.",answer:"A"},{n:4,type:"select",text:"Match this item.",options:"ABCDEFGH",answer:"C"}]}]},null,1);
const AIPROMPT="I am attaching a reading exam PDF. Convert its Reading paper (texts, questions and the answer key) into ONE valid JSON object in exactly the format below, and output only the JSON.\n\n"+TEMPLATE+"\n\nRules: write gaps inside the passage as (n)_______ ; question types are gap, select (matching; options as a letters string; answer is a letter), mcq (options list; answer is a letter A-D) and tf (answer A = True, B = False, C = Not Given). Use \"ref\" for an optional list of headings. Question numbers must be unique across the whole test.";
const msg=(t,c)=>{const m=$("#em");m.textContent=t;m.className="msg "+(c||"")};
function edit(id){editId=id;V("editor");const t=id&&TESTS.find(x=>x.id==id);$("#ej").value=t?JSON.stringify(t,null,1):"";$("#et").textContent=t?"Edit test":"Add a test";msg("")}
async function copy(t){try{await navigator.clipboard.writeText(t);return true}catch(e){const a=document.createElement("textarea");a.value=t;a.style.cssText="position:fixed;opacity:0";document.body.appendChild(a);a.select();let r=false;try{r=document.execCommand("copy")}catch(x){}a.remove();return r}}
$("#e-tpl").onclick=()=>{$("#ej").value=TEMPLATE;msg("Template inserted. Replace it with your own content.","good")};
$("#e-ai").onclick=async()=>{const k=await copy(AIPROMPT);msg(k?"AI prompt copied. Paste it to Claude with your PDF.":"Could not copy automatically.",k?"good":"bad")};
$("#e-cp").onclick=async()=>msg(await copy($("#ej").value)?"JSON copied.":"Could not copy automatically.","good");
$("#e-file").onclick=()=>$("#ef").click();
$("#ef").onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{$("#ej").value=r.result;msg("File loaded. Press Save test to add it.","good")};r.readAsText(f);e.target.value=""};
$("#e-x").onclick=home;
function validate(o){if(!o||typeof o!="object"||Array.isArray(o))return'The JSON must be an object like {"title": ..., "parts": [...]}.';if(!o.title)return'Missing "title".';if(!Array.isArray(o.parts)||!o.parts.length)return'"parts" must be a non-empty list.';const seen=new Set();
for(const [i,p] of o.parts.entries()){const w="Part "+(i+1)+": ";if(!p.name)return w+'missing "name".';if(!Array.isArray(p.passage)||!p.passage.length)return w+'"passage" must be a list of paragraphs.';if(!Array.isArray(p.questions)||!p.questions.length)return w+'"questions" must be a non-empty list.';
for(const q of p.questions){const x=w+"question "+q.n+": ";if(!Number.isInteger(q.n)||seen.has(q.n))return w+'question numbers must be unique whole numbers (check "'+q.n+'").';seen.add(q.n);
if(!["gap","select","mcq","tf"].includes(q.type))return x+'"type" must be gap, select, mcq or tf.';if(q.answer==null||q.answer==="")return x+'missing "answer".';
if(q.type=="mcq"&&(!Array.isArray(q.options)||q.options.length<2))return x+'mcq needs an "options" list.';if(q.type=="select"&&!q.options)return x+'select needs "options" (for example "ABCDEFGH").'}}return""}
function normalize(o){o.minutes=Number(o.minutes)>0?Number(o.minutes):60;const tfm={true:"A",false:"B","not given":"C","no information":"C",ng:"C"};
o.parts.forEach(p=>p.questions.forEach(q=>{q.text=String(q.text??"");if(q.type=="tf"){const k=String(q.answer).trim().toLowerCase();q.answer=tfm[k]||String(q.answer).toUpperCase()}else if(q.type!="gap")q.answer=String(q.answer).trim().toUpperCase()}));return o}
$("#e-save").onclick=()=>{let o;try{o=JSON.parse($("#ej").value)}catch(e){return msg("Invalid JSON: "+e.message,"bad")}const er=validate(o);if(er)return msg(er,"bad");normalize(o);
if(editId){o.id=editId;const i=TESTS.findIndex(t=>t.id==editId);if(i>=0)TESTS[i]=o;else TESTS.push(o)}else{let id=o.id||slug(o.title);if(TESTS.some(t=>t.id==id))id+="-"+Date.now().toString(36);o.id=id;TESTS.push(o)}
saveTests();if(editId)ls.del(skey(editId));home();note("Test saved to your library.")};
