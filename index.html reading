if(ST.done)return result();if(ST.st){if(Date.now()-ST.st>=mins()*60000)return finish();return begin()}gate()}
function gate(){V("gate");$("#gt").textContent=T.title;$("#gi").textContent=`${total(T)} questions · ${mins()} minutes. The timer starts when you press Start and cannot be paused. When time is up, your test is submitted automatically and the result is shown separately.`;$("#fn").value=ls.get("mlr.fn")||"";$("#ln").value=ls.get("mlr.ln")||""}
$("#go").onclick=()=>{const a=$("#fn").value.trim(),b=$("#ln").value.trim();if(!a||!b)return note("Please enter your first and last name.");ls.set("mlr.fn",a);ls.set("mlr.ln",b);ST.fn=a;ST.ln=b;ST.st=Date.now();ST.done=false;saveST();begin()};
function begin(){checked=false;clearInterval(tmr);tmr=setInterval(tick,1000);V("exam");render();tick()}
function tick(){const l=Math.max(0,Math.ceil(mins()*60-(Date.now()-ST.st)/1000));$("#tm").textContent=fmt(l);$("#tm").classList.toggle("low",l<300);if(l<=0)finish()}
$("#fin").onclick=()=>{const u=P.reduce((n,p)=>n+p.questions.filter(q=>!String(ST.a[q.n]||"").trim()).length,0);ask((u?u+" question"+(u>1?"s are":" is")+" unanswered. ":"")+"Finish the test now? You will not be able to return to it.",finish,"Finish")};
function score(){let c=0;const rows=P.map(p=>{const k=p.questions.filter(q=>ok(q,ST.a[q.n])).length;c+=k;return{n:p.name,k,t:p.questions.length}});const t=total(T);return{c,rows,t,sc:Math.round(c*75/t)}}
function finish(){clearInterval(tmr);const r=score();ST.done=true;ST.score=r.sc;ST.c=r.c;saveST();result()}
function result(){const r=score(),pct=Math.round(r.sc/75*100);V("result");
$("#result").innerHTML=`<div class="card rs"><p class="hint">${esc(ST.fn)} ${esc(ST.ln)} · ${esc(T.title)}</p><div class="ring" style="--p:${pct}"><div><b>${r.sc}</b><span>/ 75</span></div></div><p class="lead">${r.c} of ${r.t} answers correct</p><div class="parts">${r.rows.map(x=>`<div><span>${esc(x.n)}</span><b>${x.k}/${x.t}</b></div>`).join("")}</div><div class="row c"><button class="b" id="rv">Review answers</button><button class="b g" id="rt">Retake test</button></div></div>`;
$("#rv").onclick=()=>{checked=true;cur=0;V("review");render()};
$("#rt").onclick=()=>ask("This erases your answers, highlights and result for this test. Continue?",()=>{ST={a:{},h:{},p:{}};saveST();gate()},"Retake")}
/* ---------- rendering ---------- */
const MK=/\((\d+)\)\s*_{2,}/g;
function inlineSet(p){const g=new Set(p.questions.filter(q=>q.type=="gap").map(q=>String(q.n))),s=new Set();p.passage.join(" ").replace(MK,(m,n)=>{if(g.has(n))s.add(n);return m});return s}
function passHTML(p,inl){return p.passage.map(t=>t.startsWith("## ")?`<h3>${rich(t.slice(3))}</h3>`:t.startsWith("# ")?`<h2>${rich(t.slice(2))}</h2>`:`<p>${rich(t).replace(MK,(m,n)=>inl.has(n)?`<span class="gw"><em>${n}</em><input class="gap" data-n="${n}" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Answer ${n}"></span>`:m)}</p>`).join("")}
const opts=q=>Array.isArray(q.options)?q.options:[...String(q.options)];
function qHTML(p,inl){let h=`<p class="hint"><b>${esc(p.name)}</b> · ${esc(p.instruction||"")}</p>`;if(p.ref)h+=`<div class="ref">${rich(p.ref)}</div>`;if(inl.size)h+=`<div class="tip">Type your answers directly into the yellow blanks in the text.</div>`;
return h+p.questions.filter(q=>!inl.has(String(q.n))).map(q=>{const v=ST.a[q.n]||"";let c;
if(q.type=="gap")c=`<input type="text" class="gq" data-n="${q.n}" value="${esc(v)}" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Answer ${q.n}">`;
else if(q.type=="select")c=`<select data-n="${q.n}" aria-label="Answer ${q.n}"><option value="">Select…</option>${opts(q).map(l=>`<option${v==l?" selected":""}>${esc(l)}</option>`).join("")}</select>`;
else{const tf=q.type=="tf",arr=tf?[["A","True"],["B","False"],["C","Not Given"]]:q.options.map((o,j)=>[L[j],o]);c=`<div class="opts${tf?" r":""}">${arr.map(([k,t])=>`<button class="o" data-n="${q.n}" data-v="${k}" aria-pressed="${v==k}">${tf?"":k+") "}${esc(t)}</button>`).join("")}</div>`}
return `<div class="q" id="q${q.n}"><p><span class="n">${q.n}</span>${rich(q.text)}</p>${c}<div class="key"></div></div>`}).join("")}
function tabs(){$("#tabs").innerHTML=P.map((p,i)=>{const d=p.questions.filter(q=>String(ST.a[q.n]||"").trim()).length;return `<button class="tab" data-i="${i}" aria-pressed="${i==cur}">${esc(p.name)}<small>${d}/${p.questions.length}</small></button>`}).join("")}
function render(){tabs();const p=P[cur],inl=inlineSet(p);ps.innerHTML=ST.h[cur]||passHTML(p,inl);
$$("#ps .gap").forEach(i=>i.value=ST.a[i.dataset.n]||"");$("#pad").value=ST.p[cur]||"";qs.innerHTML=qHTML(p,inl);if(checked)grade();fabUpd()}
function grade(){P[cur].questions.forEach(q=>{const r=ok(q,ST.a[q.n]),el=$("#q"+q.n),key=String(q.answer).split("|")[0];
if(el){el.classList.add(r?"ok":"no");el.querySelector(".key").textContent=r?"Correct":"Correct answer: "+key;el.querySelectorAll("input,select,.o").forEach(x=>x.disabled=true)}
else{const i=$(`#ps .gap[data-n="${q.n}"]`);if(!i)return;i.disabled=true;const w=i.parentNode;w.classList.add(r?"ok":"no");if(!r){const s=document.createElement("span");s.className="ans";s.textContent=key;w.after(s)}}})}
$("#tabs").onclick=e=>{const b=e.target.closest(".tab");if(b){cur=+b.dataset.i;render();$("#tpane").scrollTop=qs.scrollTop=0;scrollTo(0,0)}};
function fabUpd(){const f=$("#fab"),v=document.body.dataset.v;f.hidden=!(v=="exam"||v=="review");if(f.hidden)return;const down=scrollY<qs.getBoundingClientRect().top+scrollY-200;f.textContent=down?"↓ Questions":"↑ Text";f.dataset.d=down?"1":"0"}
$("#fab").onclick=()=>scrollTo({top:$("#fab").dataset.d=="1"?qs.getBoundingClientRect().top+scrollY-70:0,behavior:"smooth"});
addEventListener("scroll",fabUpd,{passive:true});
qs.addEventListener("click",e=>{const o=e.target.closest(".o");if(!o||checked)return;ST.a[o.dataset.n]=o.dataset.v;saveST();$$(`.o[data-n="${o.dataset.n}"]`).forEach(x=>x.setAttribute("aria-pressed",x==o));tabs()});
document.addEventListener("input",e=>{const t=e.target,n=t.dataset&&t.dataset.n;if(!n||checked||!t.matches(".gap,.gq,select"))return;ST.a[n]=t.value;saveST();tabs()});
$("#pad").oninput=e=>{if(checked)return;ST.p[cur]=e.target.value;saveST()};
/* ---------- highlighting ---------- */
const tb=$("#tb"),pop=$("#pop");let rg=null,pm=null,t2;
const saveP=()=>{if(checked)return;ST.h[cur]=ps.innerHTML;saveST()};
const inPs=n=>{const el=n&&(n.nodeType==1?n:n.parentElement);return !!(el&&el.closest("#ps"))};
document.addEventListener("selectionchange",()=>{clearTimeout(t2);const s=getSelection(),ae=document.activeElement;
if(!s.rangeCount||s.isCollapsed||checked||(ae&&ae.classList&&ae.classList.contains("gap"))){tb.hidden=true;return}
const r=s.getRangeAt(0);if(!inPs(r.commonAncestorContainer)){tb.hidden=true;return}rg=r.cloneRange();
if(tool&&tool!="e"){tb.hidden=true;t2=setTimeout(()=>{const s2=getSelection();if(!s2.rangeCount||s2.isCollapsed)return;rg=s2.getRangeAt(0).cloneRange();wrap(tool)},500);return}
const b=r.getBoundingClientRect();tb.hidden=false;tb.style.top=Math.min(innerHeight-60,b.bottom+10)+"px";tb.style.left=Math.max(8,Math.min(innerWidth-230,b.left))+"px"});
tb.addEventListener("pointerdown",e=>e.preventDefault());
function wrap(c){if(checked||!rg)return null;const m=document.createElement("mark");m.className=c;try{rg.surroundContents(m)}catch(e){note("Please select text within a single paragraph.");return null}getSelection().removeAllRanges();tb.hidden=true;saveP();return m}
tb.addEventListener("click",e=>{const c=e.target.closest(".c");if(c)wrap(c.dataset.c);else if(e.target.id=="nt"){const m=wrap("y");if(m)openNote(m)}});
function openNote(m){pm=m;pop.hidden=false;$("#pn").value=m.dataset.n||"";const b=m.getBoundingClientRect();pop.style.top=Math.min(innerHeight-180,b.bottom+8)+"px";pop.style.left=Math.max(8,Math.min(innerWidth-300,b.left))+"px";$("#pn").focus()}
ps.addEventListener("click",e=>{const m=e.target.closest("mark");if(!m||!getSelection().isCollapsed||checked)return;if(tool=="e"){m.replaceWith(...m.childNodes);ps.normalize();pop.hidden=true;saveP()}else openNote(m)});
$("#tools").onclick=e=>{const b=e.target.closest("[data-t]");if(!b)return;tool=tool==b.dataset.t?null:b.dataset.t;$$("#tools [data-t]").forEach(x=>x.setAttribute("aria-pressed",x.dataset.t==tool))};
