$("#tm").hidden=$("#fin").hidden=v!="exam";$("#bk").hidden=v!="review";$("#hm").hidden=!["editor","gate","result"].includes(v);
$("#sub").textContent=T&&["gate","exam","review","result"].includes(v)?T.title:"Exam practice";scrollTo(0,0);fabUpd()}
