<div id="tb" hidden><button class="c y" data-c="y" aria-label="Yellow"></button><button class="c g" data-c="g" aria-label="Green"></button><button class="c p" data-c="p" aria-label="Pink"></button><button class="t" id="nt">✎ Note</button></div>
