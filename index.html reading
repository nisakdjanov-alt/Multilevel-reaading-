{const seen=J("mlr.seen",[]);(window.DEFAULT_TESTS||[]).forEach(d=>{if(!seen.includes(d.id)){seen.push(d.id);if(!TESTS.some(t=>t.id==d.id))TESTS.push(JSON.parse(JSON.stringify(d)))}});ls.set("mlr.seen",JSON.stringify(seen));saveTests()}
